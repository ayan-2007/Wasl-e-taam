<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waslataam.ui.controllers.RecipientDashboardController"
      spacing="20" styleClass="root">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="welcomeLabel" text="Available Donations" styleClass="header-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10">
            <Label text="Filter by Type:"/>
            <ComboBox fx:id="typeFilterComboBox" prefWidth="150" promptText="All Types" onAction="#handleFilterChange"/>
            <CheckBox fx:id="urgentCheckBox" text="Urgent Only" onAction="#handleFilterChange"/>
        </HBox>
    </HBox>
    
    <Separator/>
    
    <TableView fx:id="donationsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="expiryColumn" text="Expiry" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="expiryTime"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="250">
                <cellValueFactory><PropertyValueFactory property="location"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="donorColumn" text="Donor" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="donorName"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="actionColumn" text="Action" prefWidth="120">
                <cellFactory><ButtonTableCellFactory/></cellFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="No available donations at the moment." style="-fx-text-fill: #6a7a6e;"/>
        </placeholder>
    </TableView>
</VBox>