<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextAlignment?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waslataam.ui.controllers.AdminDashboardController"
      styleClass="page" spacing="24">
    <padding><Insets top="40" right="48" bottom="40" left="48"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="welcomeLabel" text="Operations overview" styleClass="page-title"/>
            <Label text="The network at a glance, plus the latest actions across the platform."
                   styleClass="page-subtitle" wrapText="true" maxWidth="640"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <Button text="Refresh" styleClass="button-secondary" onAction="#handleRefresh"/>
            <Label fx:id="lastUpdatedLabel" text="Updated just now" styleClass="caption"/>
        </VBox>
    </HBox>

    <HBox styleClass="metric-band">
        <VBox styleClass="metric" spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Total donations" styleClass="stat-label"/>
            <Label fx:id="totalDonationsValue" text="0" styleClass="stat-value"/>
        </VBox>
        <Region styleClass="metric-divider" maxHeight="Infinity"/>
        <VBox styleClass="metric" spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Active now" styleClass="stat-label"/>
            <Label fx:id="activeDonationsValue" text="0" styleClass="stat-value"/>
        </VBox>
        <Region styleClass="metric-divider" maxHeight="Infinity"/>
        <VBox styleClass="metric" spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Delivered" styleClass="stat-label"/>
            <Label fx:id="deliveredValue" text="0" styleClass="stat-value stat-value-accent"/>
        </VBox>
        <Region styleClass="metric-divider" maxHeight="Infinity"/>
        <VBox styleClass="metric" spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Expired" styleClass="stat-label"/>
            <Label fx:id="expiredValue" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <HBox spacing="24" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
            <VBox spacing="2">
                <Label text="Recent activity" styleClass="section-title"/>
                <Label text="The last twenty recorded actions, newest last." styleClass="section-hint"/>
            </VBox>
            <TableView fx:id="recentActivityTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Time" prefWidth="130"/>
                    <TableColumn text="Action" prefWidth="240"/>
                    <TableColumn text="Actor" prefWidth="200"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="No activity yet" styleClass="empty-title"/>
                        <Label text="Post or claim a donation and the audit trail will start filling in here."
                               styleClass="empty-body" wrapText="true" maxWidth="360" textAlignment="CENTER"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="4" prefWidth="300" minWidth="280" maxWidth="320" HBox.hgrow="NEVER">
            <VBox spacing="2">
                <Label text="Go deeper" styleClass="section-title"/>
                <Label text="Three places to inspect or change how the network behaves." styleClass="section-hint" wrapText="true"/>
            </VBox>

            <Button styleClass="link-card" maxWidth="Infinity" accessibleText="Open matching strategy" onAction="#handleStrategySwitcher">
                <graphic>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Matching strategy" styleClass="link-card-title"/>
                        <Label text="Choose how new donations find a recipient." styleClass="link-card-body" wrapText="true"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="link-card" maxWidth="Infinity" accessibleText="Open audit report" onAction="#handleAuditReport">
                <graphic>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Audit report" styleClass="link-card-title"/>
                        <Label text="Trace every state change and undo the latest action." styleClass="link-card-body" wrapText="true"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="link-card" maxWidth="Infinity" accessibleText="Open impact dashboard" onAction="#handleImpactDashboard">
                <graphic>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Impact dashboard" styleClass="link-card-title"/>
                        <Label text="See meals served, food saved and CO₂ avoided." styleClass="link-card-body" wrapText="true"/>
                    </VBox>
                </graphic>
            </Button>
        </VBox>
    </HBox>
</VBox>
