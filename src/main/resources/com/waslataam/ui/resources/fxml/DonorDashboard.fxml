<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waslataam.ui.controllers.DonorDashboardController"
      spacing="20" styleClass="root">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="welcomeLabel" id="welcomeLabel" text="Donor Dashboard" styleClass="header-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="postDonationButton" id="postDonationButton" text="+ Post New Donation" styleClass="button" onAction="#handlePostDonation"/>
    </HBox>
    
    <Separator/>
    
    <Label text="Your Donations" styleClass="subheader-label"/>
    
    <TableView fx:id="donationsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="expiryColumn" text="Expiry" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="expiryTime"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="location"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="postedColumn" text="Posted" prefWidth="160">
                <cellValueFactory><PropertyValueFactory property="postedAt"/></cellValueFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="No donations yet. Click 'Post New Donation' to get started." style="-fx-text-fill: #6a7a6e;"/>
        </placeholder>
    </TableView>
</VBox>