<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waslataam.ui.controllers.LoginController"
      styleClass="root" prefWidth="1080" prefHeight="720">

    <!-- Brand panel: the one deliberate, memorable moment of the product. -->
    <VBox styleClass="login-brand" prefWidth="470" minWidth="420" maxWidth="520" HBox.hgrow="NEVER">
        <padding><Insets top="44" right="44" bottom="44" left="44"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="sidebar-mark">
                <SVGPath content="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"
                         styleClass="brand-leaf" scaleX="0.9" scaleY="0.9"/>
            </StackPane>
            <Label text="Wasl-e-Ta'am" styleClass="brand-inline-wordmark"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="وصل طعام" styleClass="brand-arabic"/>
        <Label text="Surplus food, shared with dignity." styleClass="brand-headline" wrapText="true" maxWidth="380"/>
        <Label text="We connect kitchens, markets and event halls with community organisations across Karachi — so good food reaches a table instead of a bin."
               styleClass="brand-body" wrapText="true" maxWidth="380">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>

        <VBox spacing="14">
            <VBox.margin><Insets top="32"/></VBox.margin>
            <Label text="How a donation moves" styleClass="journey-heading"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="1" styleClass="journey-step-number"/>
                <VBox spacing="1">
                    <Label text="Post" styleClass="journey-step-title"/>
                    <Label text="A donor lists what is left over." styleClass="journey-step-body"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="2" styleClass="journey-step-number"/>
                <VBox spacing="1">
                    <Label text="Claim" styleClass="journey-step-title"/>
                    <Label text="A kitchen reserves what it can use." styleClass="journey-step-body"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="3" styleClass="journey-step-number"/>
                <VBox spacing="1">
                    <Label text="Collect" styleClass="journey-step-title"/>
                    <Label text="A volunteer brings it in." styleClass="journey-step-body"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="4" styleClass="journey-step-number"/>
                <VBox spacing="1">
                    <Label text="Deliver" styleClass="journey-step-title"/>
                    <Label text="Meals reach the table. Impact is recorded." styleClass="journey-step-body"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="A Software Design &amp; Architecture course project." styleClass="brand-footnote">
            <VBox.margin><Insets top="24"/></VBox.margin>
        </Label>
    </VBox>

    <!-- Sign-in / sign-up form -->
    <VBox styleClass="login-form-panel" HBox.hgrow="ALWAYS" alignment="CENTER">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="login-scroll" maxWidth="430" prefViewportWidth="400">
            <VBox styleClass="login-form" spacing="16" maxWidth="400">

                <VBox spacing="6">
                    <Label fx:id="formTitleLabel" text="Sign in" styleClass="page-title"/>
                    <Label fx:id="formSubtitleLabel"
                           text="Sign in with the email and password you registered. Demo accounts are ready to explore every role."
                           styleClass="page-subtitle" wrapText="true"/>
                </VBox>

                <VBox fx:id="demoBox" styleClass="hint-box" spacing="6">
                    <Label text="Demo accounts · password demo1234" styleClass="hint-title"/>
                    <ComboBox fx:id="demoAccountComboBox" promptText="Fill in a demo account"
                              maxWidth="Infinity" onAction="#handleDemoAccountSelected"/>
                    <Label text="Donor, recipient, volunteer and two administrator accounts (one full, one limited)."
                           styleClass="hint-body" wrapText="true"/>
                </VBox>

                <VBox fx:id="roleRow" spacing="8" visible="false" managed="false">
                    <Label text="I am signing up as" styleClass="field-label" labelFor="$roleComboBox"/>
                    <ComboBox fx:id="roleComboBox" promptText="Select your role" maxWidth="Infinity"/>
                    <Label text="Administrator accounts are provisioned internally and cannot be created here."
                           styleClass="field-hint" wrapText="true"/>
                </VBox>

                <VBox fx:id="nameRow" spacing="8" visible="false" managed="false">
                    <Label text="Full name" styleClass="field-label" labelFor="$nameField"/>
                    <TextField fx:id="nameField" promptText="e.g. Amina Siddiqui"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Email" styleClass="field-label" labelFor="$emailField"/>
                    <TextField fx:id="emailField" promptText="you@example.org"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Password" styleClass="field-label" labelFor="$passwordField"/>
                    <PasswordField fx:id="passwordField" promptText="At least 8 characters, letters and numbers"/>
                </VBox>

                <VBox fx:id="confirmRow" spacing="8" visible="false" managed="false">
                    <Label text="Confirm password" styleClass="field-label" labelFor="$confirmPasswordField"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password"/>
                </VBox>

                <Label fx:id="errorLabel" styleClass="form-error" visible="false" managed="false" wrapText="true"/>

                <Button fx:id="loginButton" text="Sign in" maxWidth="Infinity" defaultButton="true" onAction="#handleLogin"/>

                <Button fx:id="modeToggleButton" text="New here? Create an account" styleClass="button-link"
                        maxWidth="Infinity" onAction="#handleModeToggle"/>

                <VBox styleClass="hint-box" spacing="4">
                    <Label text="Administrator access is restricted" styleClass="hint-title"/>
                    <Label text="Only pre-approved accounts can sign in as an administrator. Public sign-up is limited to donor, recipient and volunteer roles."
                           styleClass="hint-body" wrapText="true"/>
                </VBox>

                <Label text="Accounts and passwords are stored in a local SQLite database on this device."
                       styleClass="caption" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
