<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waslataam.ui.controllers.MainShellController"
            styleClass="root" prefWidth="1280" prefHeight="840">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="252" minWidth="252" maxWidth="252" spacing="0">
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <StackPane styleClass="sidebar-mark">
                    <SVGPath content="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"
                             styleClass="brand-leaf" scaleX="0.8" scaleY="0.8"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="Wasl-e-Ta'am" styleClass="sidebar-wordmark"/>
                    <Label text="Food rescue network" styleClass="sidebar-caption"/>
                </VBox>
            </HBox>

            <VBox styleClass="sidebar-user" spacing="2">
                <Label fx:id="userNameLabel" text="Signed in" styleClass="sidebar-user-name"/>
                <Label fx:id="userRoleLabel" text="Role" styleClass="sidebar-user-role"/>
            </VBox>

            <Label text="Workspace" styleClass="sidebar-section"/>
            <VBox fx:id="navButtons" spacing="4"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="themeButton" text="Dark mode" styleClass="sidebar-link" maxWidth="Infinity" onAction="#handleThemeToggle"/>
            <Button fx:id="logoutButton" text="Sign out" styleClass="sidebar-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
